DATABASE_URL=postgresql://user:password@localhost:5432/qwapp
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1h
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# DocuSign (signature client des lettres de mission) — optionnel, l'envoi
# renvoie une erreur claire si absent. Voir docs internes pour la checklist de
# configuration (Integration Key, clé RSA, consentement JWT one-time).
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Clé privée RSA au format PEM, avec les retours à la ligne échappés en \n
DOCUSIGN_PRIVATE_KEY=
# account-d.docusign.com en sandbox, account.docusign.com en production
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com
# URL publique de ce backend, pour que DocuSign notifie les changements de statut
DOCUSIGN_WEBHOOK_URL=
# Optionnel : active la vérification de signature HMAC des webhooks DocuSign
DOCUSIGN_WEBHOOK_HMAC_KEY=